# ESP32-S3 PSRAM Configuration for Supercon 2025 Badge
# This overrides the default sdkconfig to properly initialize 8MB OPI PSRAM

# Enable PSRAM
CONFIG_ESP32S3_SPIRAM_SUPPORT=y

# PSRAM Type: Octal (8-line) PSRAM
CONFIG_SPIRAM_MODE_OCT=y

# PSRAM Speed: 80MHz
CONFIG_SPIRAM_SPEED_80M=y

# PSRAM Size: 8MB
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n

# PSRAM Cache Configuration
CONFIG_SPIRAM_CACHE_WORKAROUND_STRATEGY_MEMW=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Use PSRAM for large allocations
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# PSRAM Timing Configuration
CONFIG_SPIRAM_FLASH_LOAD_TO_PSRAM=y

# Memory allocation strategy
CONFIG_SPIRAM_MEMTEST=y
