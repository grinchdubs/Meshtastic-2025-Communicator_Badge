# ESP32-S3 PSRAM Configuration for Supercon 2025 Badge
# Based on working MicroPython SPIRAM_OCT configuration

# Enable PSRAM - Octal Mode
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y

# CRITICAL: Use VENDOR config mode (lets ESP-IDF auto-detect PSRAM chip)
CONFIG_SPIRAM_MODE_OCT=y

# Speed: 80MHz (matching MicroPython)
CONFIG_SPIRAM_SPEED_80M=y

# Initialize at boot
CONFIG_SPIRAM_BOOT_INIT=y

# Allow boot even if PSRAM fails (for debugging)
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Memory management - use PSRAM for large allocations
CONFIG_SPIRAM_USE=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_USE_MEMMAP=y

# Reserve internal RAM for critical operations
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Cache workaround
CONFIG_SPIRAM_CACHE_WORKAROUND=y

# Wi-Fi and LWIP can use PSRAM
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Timing (critical for reliability)
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# Memory test on boot
CONFIG_SPIRAM_MEMTEST=y

# Flash configuration to match MicroPython
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
