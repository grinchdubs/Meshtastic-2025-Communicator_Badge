# ESP32-S3 PSRAM Configuration for Supercon 2025 Badge
# Simplified to match MicroPython's minimal SPIRAM_OCT configuration

# Enable SPIRAM in Octal mode (matches MicroPython sdkconfig.spiram_oct)
CONFIG_SPIRAM_MODE_QUAD=
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y

# Threshold for preferring small allocations from internal memory first
# (MicroPython uses 8192, we use 16384 for Meshtastic requirements)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# Flash configuration
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
